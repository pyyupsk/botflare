{
  "name": "discordflare-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "nit install",
    "test": "vitest run",
    "typecheck": "bun check && bun run --filter './packages/*' typecheck"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@pyyupsk/nit": "^0.3.0",
    "@types/bun": "latest",
    "eslint-plugin-jsdoc": "^65.4.3",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "7",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "nit": {
    "hooks": {
      "pre-commit": {
        "stages": {
          "**/*.{ts,js,json,md}": "bun x oxfmt --check {staged_files} && bun x oxlint {staged_files}"
        }
      },
      "commit-msg": "bun x commitlint --edit $1",
      "pre-push": "bun run typecheck && bun run test"
    }
  }
}
