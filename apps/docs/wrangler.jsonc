{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "botflare-docs",
  "compatibility_date": "2026-11-05",
  // Static assets only: no Worker script runs.
  "assets": {
    "directory": "./dist",
    // Unknown URLs get dist/404.html with status 404.
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "botflare.fasu.dev", "custom_domain": true }],
}
