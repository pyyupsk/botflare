{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["../../packages/botflare/src/index.ts", "../../packages/botflare/src/gateway.ts"],
  "tsconfig": "../../packages/botflare/tsconfig.json",
  "out": "src/content/api",
  "plugin": ["typedoc-plugin-markdown", "typedoc-plugin-missing-exports"],
  "internalModule": "Other types",
  "excludeExternals": true,
  "excludeInternal": true,
  "gitRevision": "main",
  "readme": "none",
