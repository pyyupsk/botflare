---
import type { NavGroup } from '#lib/nav';

type Props = { groups: NavGroup[] };

const { groups } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const [guides, ...api] = groups;
const onApi = path.startsWith(`${base}/api/`);
---

<div
  id="menu"
  popover
  class="sheet glass-panel inset-x-0 top-auto bottom-0 m-0 flex max-h-(--sheet-height) w-full flex-col rounded-t-3xl p-0 text-text backdrop:bg-bg/70 backdrop:backdrop-blur-sm"
  aria-label="Pages"
>
  <div class="px-5 pt-3 pb-4">
    <div class="mx-auto mb-4 h-1 w-10 rounded-full bg-line-strong" aria-hidden="true"></div>
    <div class="flex items-center gap-3">
      <button
        class="flex h-12 min-w-0 flex-1 items-center gap-3 rounded-2xl border border-line-strong px-4 text-left font-mono text-faint"
        data-slash-open
        popovertarget="menu"
        popovertargetaction="hide"
      >
        <span class="text-lg text-accent" aria-hidden="true">/</span>
        <span class="truncate">search the docs</span>
      </button>
      <button
        class="grid size-12 place-items-center rounded-2xl border border-line text-muted"
        popovertarget="menu"
        popovertargetaction="hide"
        aria-label="Close menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>

    <div class="mt-4 grid grid-cols-2 rounded-2xl border border-line p-1 font-mono text-sm" role="tablist">
      <button class="rounded-xl py-2 text-muted aria-selected:bg-raised aria-selected:text-text" role="tab" aria-selected={onApi ? 'false' : 'true'} aria-controls="sheet-guides" data-sheet-tab>
        guides
      </button>
      <button class="rounded-xl py-2 text-muted aria-selected:bg-raised aria-selected:text-text" role="tab" aria-selected={onApi ? 'true' : 'false'} aria-controls="sheet-api" data-sheet-tab>
        api
      </button>
    </div>
  </div>

  <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-5 pb-4">
    <ul id="sheet-guides" role="tabpanel" hidden={onApi} class="space-y-1">
      {
        guides?.items.map((item) => {
          const active = item.href === path;
          return (
            <li>
              <a
                class:list={[
                  'flex min-h-12 items-center gap-3 rounded-xl px-3 text-base',
                  active ? 'bg-raised font-semibold text-accent' : 'text-muted',
                ]}
                href={item.href}
                aria-current={active ? 'page' : undefined}
              >
                <span class:list={['font-mono', active ? 'text-accent' : 'text-faint']} aria-hidden="true">/</span>
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>

    <div id="sheet-api" role="tabpanel" hidden={!onApi} class="space-y-5">
      {
        api.map((group) => (
          <section>
            <h2 class="mb-2 font-mono text-xs text-faint">{group.label}</h2>
            <ul class="grid grid-cols-2 gap-1.5">
              {group.items.map((item) => {
                const active = item.href === path;
                return (
                  <li class="min-w-0">
                    <a
                      class:list={[
                        'flex min-h-11 items-center truncate rounded-xl border px-3 font-mono text-sm',
                        active ? 'border-transparent bg-raised text-accent' : 'border-line text-muted',
                      ]}
                      href={item.href}
                      aria-current={active ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </div>

  <div class="flex items-center gap-2 border-t border-line px-5 py-3 pb-(--sheet-safe) text-sm">
    <a class="rounded-xl px-3 py-2 text-muted" href="https://github.com/pyyupsk/botflare/tree/main/examples">Examples</a>
    <a class="rounded-xl px-3 py-2 text-muted" href="https://github.com/pyyupsk/botflare">GitHub</a>
    <button class="ms-auto rounded-xl border border-line px-3 py-2 font-mono text-xs text-muted" data-theme-toggle>
      <span class="hidden dark:inline">light mode</span><span class="dark:hidden">dark mode</span>
    </button>
  </div>
</div>

<style is:global>
  :root {
    --sheet-height: 85dvh;
    --sheet-safe: max(0.75rem, env(safe-area-inset-bottom));
  }

  .sheet {
    transition:
      translate 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
      overlay 0.3s allow-discrete,
      display 0.3s allow-discrete;
    translate: 0 100%;
  }

  .sheet:popover-open {
    translate: 0 0;

    @starting-style {
      translate: 0 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet {
      transition: none;
    }
  }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-sheet-tab]')];
  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      for (const other of tabs) {
        const on = other === tab;
        other.setAttribute('aria-selected', String(on));
        document.getElementById(other.getAttribute('aria-controls') ?? '')?.toggleAttribute('hidden', !on);
      }
    });
  }
</script>
