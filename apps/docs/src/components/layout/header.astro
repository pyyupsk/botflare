---
import { version } from 'botflare/package.json';

import Sheet from '#components/nav/sheet.astro';
import type { NavGroup } from '#lib/nav';

type Props = { groups: NavGroup[] };

const { groups } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const links = [
  { label: 'Guides', href: `${base}/guides/getting-started/`, active: path.startsWith(`${base}/guides/`) },
  { label: 'API', href: `${base}/api/`, active: path.startsWith(`${base}/api/`) },
  { label: 'Examples', href: 'https://github.com/pyyupsk/botflare/tree/main/examples', active: false },
];
---

<header class="sticky top-0 z-30 glass-bar">
  <div class="mx-auto flex h-16 max-w-screen-2xl items-center gap-3 px-4 sm:gap-6 sm:px-6">
    <button
      class="grid size-9 place-items-center rounded-lg border border-line text-muted hover:text-text lg:hidden"
      popovertarget="menu"
      aria-label="Menu"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>

    <a class="flex items-center gap-2.5 font-bold" href={`${base}/`}>
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="6" class="fill-accent-fill"></rect><path d="M14.6 5h2.6L9.4 19H6.8z" class="fill-accent-ink"></path></svg>
      <span class="text-lg tracking-tight">botflare</span>
    </a>
    <a
      class="hidden rounded-md border border-line px-1.5 font-mono text-xs text-faint hover:text-text sm:block"
      href="https://github.com/pyyupsk/botflare/releases">v{version}</a
    >

    <nav class="hidden items-center gap-5 text-sm md:flex" aria-label="Site">
      {
        links.map((link) => (
          <a
            class:list={['hover:text-text', link.active ? 'text-text' : 'text-muted']}
            href={link.href}
            aria-current={link.active ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <button
      class="ms-auto flex h-10 min-w-0 items-center gap-2 rounded-xl border border-line px-3 font-mono text-sm text-faint hover:border-line-strong sm:w-72"
      data-slash-open
      aria-label="Search the docs"
    >
      <span class="text-accent" aria-hidden="true">/</span>
      <span class="truncate" data-slash-hint>answers defer</span>
      <kbd class="ms-auto hidden rounded-md border border-line px-1.5 text-xs sm:block">/</kbd>
    </button>

    <a
      class="hidden size-9 place-items-center rounded-lg text-muted hover:text-text sm:grid"
      href="https://github.com/pyyupsk/botflare"
      aria-label="GitHub"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path></svg>
    </a>
    <button
      class="grid size-9 place-items-center rounded-lg text-muted hover:text-text"
      data-theme-toggle
      aria-label="Switch between light and dark"
    >
      <svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      <svg class="dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
    </button>
  </div>
</header>

<Sheet groups={groups} />

<script>
  for (const toggle of document.querySelectorAll('[data-theme-toggle]')) {
    toggle.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
    });
  }
</script>
