{
  "name": "botflare-docs",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*",
    "#lib/*": "./src/lib/*.ts",
    "#styles/*": "./src/styles/*"
  },
  "scripts": {
    "api": "typedoc && bun scripts/links.ts",
    "build": "bun run api && astro build && pagefind --site dist",
    "dev": "bun run api && astro dev",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.2",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/spline-sans-mono": "5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.3.6",
    "astro-expressive-code": "0.44.3",
    "botflare": "workspace:*",
    "tailwindcss": "^4.3.4",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typedoc-plugin-missing-exports": "4.1.4"
  },
  "devDependencies": {
    "pagefind": "1.6.0"
  }
}
