{
  "name": "botflare",
  "version": "0.1.1",
  "description": "Discord bots on Cloudflare Workers, with gateway events, typed REST and Durable Objects",
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "discord",
    "discord-api",
    "discord-bot",
    "durable-objects",
    "interactions",
    "slash-commands",
    "typescript"
  ],
  "homepage": "https://github.com/pyyupsk/botflare#readme",
  "bugs": "https://github.com/pyyupsk/botflare/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyyupsk/botflare.git",
    "directory": "packages/botflare"
  },
  "bin": {
    "botflare": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#test/*": "./test/*.ts",
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./gateway": "./dist/gateway.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "gen:routes": "bun scripts/routes.ts && oxfmt src/lib/routes.ts",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cli"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "discord-api-types": "^0.38.57"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^26.6.6",
    "publint": "^0.3.25",
    "tsdown": "^0.23.5"
  }
}
